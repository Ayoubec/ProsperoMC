* text=auto
*.sh text eol=lf
*.patch text eol=lf
# Unified-diff context markers include a space on otherwise blank lines.
*.patch whitespace=-blank-at-eol,-blank-at-eof
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.ld text eol=lf
Makefile text eol=lf
.clang-format text eol=lf
.clang-tidy text eol=lf
tooling/prospero-clang18 text eol=lf
*.ps1 text eol=crlf
*.png binary
*.webp binary
*.dds binary
*.at9 binary
*.prx binary
*.bin binary
